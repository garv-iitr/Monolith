                </mxCell>

                <!-- Legend Col 2: Mux Port Encoding -->
                <mxCell id="leg_col2_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1E293B;" value="MUX PORT ENCODING" vertex="1">
                    <mxGeometry height="20" width="200" x="600" y="865" as="geometry"/>
                </mxCell>
                <mxCell id="leg_col2_text" parent="1" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" value="μFetch MUX (sel = next_addr): 0 = μPC+1 (mloadIR, mdecode, mmov, madd)&#xa;  1 = branchTarget (mb) · 2 = switch entry (mswitch) · 3 = M1 out (mbeq)&#xa;M1 MUX (sel = isMBranch): 0 = μPC+1 · 1 = branchTarget" vertex="1">
                    <mxGeometry height="60" width="520" x="600" y="890" as="geometry"/>
                </mxCell>

                <!-- Legend Col 3: Principles -->
                <mxCell id="leg_col3_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1E293B;" value="HORIZONTAL μCU PRINCIPLES" vertex="1">
                    <mxGeometry height="20" width="250" x="1180" y="865" as="geometry"/>
                </mxCell>
                <mxCell id="leg_col3_text" parent="1" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" value="1. Zero decode latency: The control signals are raw bits of the ROM word.&#xa;2. Single-cycle micro-branch: comparator in Shared bus gives isMBranch = (write_bus == μimm), steering M1 then μFetch MUX.&#xa;3. Preamble at μPC 0..3 fetches IR and dispatches; every routine ends with mb .begin." vertex="1">
                    <mxGeometry height="80" width="660" x="1180" y="890" as="geometry"/>
                </mxCell>

            </root>
        </mxGraphModel>
    </diagram>
</mxfile>