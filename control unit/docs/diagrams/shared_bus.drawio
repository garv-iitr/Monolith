        <!-- ======================================================== -->
        <!-- ============ BOTTOM NOTES / SPECIFICATIONS ============= -->
        <!-- ======================================================== -->
        <mxCell id="note_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#BDC3C7;fontFamily=Helvetica,Arial,sans-serif;align=left;verticalAlign=middle;" value="" vertex="1">
          <mxGeometry height="75" width="1400" x="50" y="810" as="geometry" />
