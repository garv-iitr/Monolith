                <mxCell id="legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#BDC3C7;fontFamily=Helvetica,Arial,sans-serif;align=left;verticalAlign=top;" value="" vertex="1">
