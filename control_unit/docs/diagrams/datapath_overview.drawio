                <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica,Arial,sans-serif;fontSize=13;fontColor=#555555;" value="Full Architectural Integration: 6-bit Opcode [31:26], 2-bit Mode [25:24], 16 GPRs (R0–R15), 16-bit Immediate [15:0], 26-bit Branch Offset [25:0]" vertex="1">
                    <mxGeometry height="25" width="950" x="60" y="60" as="geometry"/>
