                <mxCell id="legend_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica,Arial,sans-serif;fontSize=13;fontStyle=1;fontColor=#2C3E50;" value="RISC201 Architectural Specifications &amp; Legend" vertex="1">
                    <mxGeometry height="25" width="490" x="1345" y="105" as="geometry"/>
                </mxCell>
                <mxCell id="legend_body" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica,Arial,sans-serif;fontSize=11;fontColor=#34495E;spacingLeft=5;" value="&lt;b&gt;Instruction Word Bit Allocation [31:0]:&lt;/b&gt;&#xa; • &lt;b&gt;opcode [31:26]&lt;/b&gt; (6 bits) : 64 Opcode entries to MCU Switch Unit&#xa; • &lt;b&gt;mode [25:24]&lt;/b&gt; (2 bits) : 00=Reg, 01=Signed Imm, 10=Unsigned Imm, 11=High Imm&#xa; • &lt;b&gt;rd [23:20]&lt;/b&gt; (4 bits) : Destination GPR / FPR index (R0–R15 / F0–F15)&#xa; • &lt;b&gt;rs1 [19:16]&lt;/b&gt; (4 bits) : 1st Source register index&#xa; • &lt;b&gt;rs2 [15:12]&lt;/b&gt; (4 bits) : 2nd Source register index&#xa; • &lt;b&gt;imm16 [15:0]&lt;/b&gt; (16 bits) : Unexpanded immediate field&#xa; • &lt;b&gt;offset26 [25:0]&lt;/b&gt; (26 bits) : PC-relative word branch target: PC + (offset26 &lt;&lt; 2)&#xa;&#xa;&lt;b&gt;Color Coding &amp; Block Hierarchy:&lt;/b&gt;&#xa; • &lt;font color=&quot;#274E13&quot;&gt;&lt;b&gt;Sage Green&lt;/b&gt;&lt;/font&gt; : Microcontrol Unit &amp; Microsequencer (Brain)&#xa; • &lt;font color=&quot;#1E3A8A&quot;&gt;&lt;b&gt;Sky Blue&lt;/b&gt;&lt;/font&gt; : Physical Memories &amp; Combinational Circle Adders&#xa; • &lt;font color=&quot;#78281F&quot;&gt;&lt;b&gt;Peach / Coral&lt;/b&gt;&lt;/font&gt; : Datapath Units &amp; Internal Micro-Registers&#xa; • &lt;font color=&quot;#006064&quot;&gt;&lt;b&gt;Cyan Bar&lt;/b&gt;&lt;/font&gt; : Shared Bus System (Write Bus, Transfer MUX, Read Bus)&#xa; • &lt;font color=&quot;#7D6608&quot;&gt;&lt;b&gt;Warm Amber&lt;/b&gt;&lt;/font&gt; : Condition Status Flags Register (Z, N, C, V)&#xa;&#xa;&lt;b&gt;Wire Conventions:&lt;/b&gt;&#xa; • &lt;b&gt;Solid Slate (#4A6572)&lt;/b&gt; : Data, address, and register busses (Orthogonal with hop arcs)&#xa; • &lt;b&gt;Dashed Red (#C0392B)&lt;/b&gt; : Functional unit control signals (args)" vertex="1">
                    <mxGeometry height="280" width="500" x="1345" y="135" as="geometry"/>
                </mxCell>
